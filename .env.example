# Copy to .env and fill in. .env is gitignored.

# Where the connector reaches ComfyUI. Note the connector's own default is
# 5545, which is NOT ComfyUI's standard 8188 - so this must be set explicitly
# whichever port ComfyUI ends up on.
COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# Where the connector itself listens. Its own default is 0.0.0.0, which exposes
# an unauthenticated API to the LAN; RapidRAW runs on this machine, so bind
# loopback. Port 5000 also collides with AirPlay Receiver if that is enabled.
HOST=127.0.0.1
PORT=5000

# Absolute path to the ComfyUI checkout. Kept out of git: it embeds the username.
COMFYUI_DIR=

# Absolute path to the RapidRAW-AI-Connector checkout.
CONNECTOR_DIR=

# Absolute path to the RapidRAW checkout. Only needed from phase 4, when
# RapidRAW is built from a fork rather than downloaded.
RAPIDRAW_DIR=
